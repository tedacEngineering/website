# Form endpoint (Formspree, Getform, Basin, or your own API). Create one form for the site and paste its URL.
# If empty, forms fall back to opening the visitor's email app addressed to SITE.email.
VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Sanity CMS (lets the client edit news and jobs). Leave empty to show the built-in demo content.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
